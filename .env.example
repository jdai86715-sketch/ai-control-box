# 模型后端：llama_cpp（默认）。rules 仅用于不启动模型时的本地规则测试。
AI_BACKEND=llama_cpp
LLAMA_CPP_URL=http://127.0.0.1:8080
LLAMA_CPP_MODEL=local-model

# 可由 AI 启动的应用：展示名称=可执行命令
ALLOWED_APPS=记事本=notepad.exe,计算器=calc.exe

# 可由 list_files 浏览的目录，用分号分隔。请替换成你的实际目录。
SAFE_DIRECTORIES=C:\\Users\\YOUR_USERNAME\\Desktop

# MQTT 硬件控制：Broker 地址、主题前缀和设备白名单。
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=ai-box
MQTT_DEVICES=客厅灯=living-room-light
